    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.525"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.2"
  },
  "version": "0.1.0",
  "description": "Cut, caption and render vertical shorts: waveform cuts and GPU encoding with ffmpeg, captions and motion graphics in React (Remotion).",
